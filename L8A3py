import tkinter as tk
from datetime import date

def calculate_age():
    name = entry_name.get()
    try:
        birth_date = date(int(entry_year.get()), int(entry_month.get()), int(entry_day.get()))
        today = date.today()
        age = today.year - birth_date.year - ((today.month, today.day) < (birth_date.month, birth_date.day))
        result_label.config(text=f"Hello {name}, you are {age} years old!", fg="#2ecc71")
    except ValueError:
        result_label.config(text="Please enter valid date details", fg="#e74c3c")

root = tk.Tk()
root.title("Age Calculator App")
root.geometry("400x400")
root.configure(padx=20, pady=20)

labels_text = ["Name:", "Day:", "Month:", "Year:"]
entries = []

for i, text in enumerate(labels_text):
    lbl = tk.Label(root, text=text, font=("Arial", 12))
    lbl.grid(row=i, column=0, sticky="w", pady=10)
    ent = tk.Entry(root, font=("Arial", 12))
    ent.grid(row=i, column=1, pady=10, padx=10)
    entries.append(ent)

entry_name, entry_day, entry_month, entry_year = entries

calc_button = tk.Button(root, text="Calculate Age", command=calculate_age, bg="#3498db", fg="white", font=("Arial", 12, "bold"))
calc_button.grid(row=4, column=0, columnspan=2, pady=20)

result_label = tk.Label(root, text="", font=("Arial", 12, "italic"), wraplength=350)
result_label.grid(row=5, column=0, columnspan=2, pady=10)

root.mainloop()
